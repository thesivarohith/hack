    "setup_instructions": {
        "local_setup": {
            "prerequisites": [
                "Python 3.10 or higher",
                "Ollama installed (https://ollama.ai)",
                "8GB+ RAM",
                "Git"
            ],
            "steps": [
                "git clone https://github.com/thesivarohith/hack.git",
                "cd hack",
                "python -m venv venv",
                "source venv/bin/activate (Windows: venv\\Scripts\\activate)",
                "pip install -r requirements.txt",
                "ollama pull llama3.2:1b",
                "ollama pull nomic-embed-text",
                "uvicorn backend.main:app --reload &",
                "streamlit run app.py",
                "Open http://localhost:8501"
            ],
            "no_credentials_needed": true
        },
        "cloud_setup": {
            "platform": "Hugging Face Spaces",
            "prerequisites": {
                "accounts_needed": [
                    "Hugging Face account (free)",
                    "Supabase account (free)"
                ],
                "tokens_needed": [
                    "HuggingFace API token (from hf.co/settings/tokens)",
                    "Supabase URL (from project settings)",
                    "Supabase anon/service key (from project API settings)"
                ]
            },
            "steps": [
                "Fork repository to your GitHub",
                "Create Supabase project",
                "Run SQL: CREATE TABLE student_profiles (id UUID PRIMARY KEY, student_id TEXT UNIQUE, profile_data JSONB, created_at TIMESTAMPTZ, updated_at TIMESTAMPTZ); CREATE INDEX idx_student_id ON student_profiles(student_id);",
                "Go to HuggingFace Spaces → New Space",
                "Link GitHub repo (or upload files)",
                "Go to Settings → Variables",
                "Add secrets: HUGGINGFACE_API_TOKEN, SUPABASE_URL, SUPABASE_KEY",
                "Wait for build (~10-15 minutes)",
                "Access at https://huggingface.co/spaces/YOUR_USERNAME/focusflow"
            ],
            "optional_customization": [
                "Change LLM model in backend/config.py",
                "Adjust chunk size in backend/rag_engine.py",
                "Customize UI colors in app.py CSS"
            ]
        }
    },
